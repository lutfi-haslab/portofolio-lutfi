---
import { getCollection, render } from 'astro:content';
import Layout from '../../layout/Layout.astro';
import { getPostImage, getReadingTime } from '../../utils/blogHelper';
import { 
    FiArrowLeft, 
    FiArrowRight, 
    FiBookmark, 
    FiShare2, 
    FiHeart, 
    FiCalendar, 
    FiClock, 
    FiTag 
} from 'react-icons/fi';

export async function getStaticPaths() {
    const allPosts = await getCollection('blog');
    const sorted = allPosts
        .filter((p) => p.id !== 'index')
        .sort((a, b) => {
            const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
            const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
            return dateB - dateA;
        });

    return sorted.map((post, index) => {
        // In descending date order:
        // previous is older (index + 1), next is newer (index - 1)
        const nextPost = index > 0 ? sorted[index - 1] : null;
        const prevPost = index < sorted.length - 1 ? sorted[index + 1] : null;

        // Recommendations: 3 other posts
        const recommendations = sorted
            .filter((p) => p.id !== post.id)
            .slice(0, 3);

        return {
            params: { slug: post.id },
            props: { post, prevPost, nextPost, recommendations },
        };
    });
}

const { post, prevPost, nextPost, recommendations } = Astro.props;
const { Content } = await render(post);

const dateFormatted = post.data.date
    ? new Date(post.data.date).toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
      })
    : 'Article';

const readingTime = getReadingTime(post.body || '');
const heroImage = getPostImage(post);
---

<Layout title={post.data.title} description={post.data.description} ogImage={heroImage || undefined}>
    <article class="container mx-auto px-6 py-12 max-w-3xl font-sans">
        
        {/* Back Link */}
        <div class="mb-8">
            <a
                href="/blog"
                class="inline-flex items-center space-x-2 text-xs font-mono text-gray-400 hover:text-white transition-colors"
            >
                <FiArrowLeft className="w-3.5 h-3.5" />
                <span>All Writings</span>
            </a>
        </div>

        {/* Article Header (Medium Style) */}
        <header class="space-y-6 pb-6">
            
            {/* Tag Pills */}
            {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag: string) => (
                        <span class="px-3 py-1 rounded-full text-xs font-mono bg-gray-900 text-gray-300 border border-gray-800">
                            {tag}
                        </span>
                    ))}
                </div>
            )}

            {/* Title */}
            <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
                {post.data.title}
            </h1>

            {/* Subtitle / Description */}
            {post.data.description && (
                <p class="text-lg sm:text-xl text-gray-400 leading-relaxed font-normal">
                    {post.data.description}
                </p>
            )}

            {/* Author Row (Medium Style) */}
            <div class="flex items-center justify-between pt-4 border-t border-gray-900">
                <div class="flex items-center space-x-3.5">
                    <img
                        src="https://avatars.githubusercontent.com/u/108409669?v=4"
                        alt="Lutfi Ikbal Majid"
                        class="w-11 h-11 rounded-full object-cover border border-gray-700"
                    />
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="font-bold text-white text-sm">
                                Lutfi Ikbal Majid
                            </span>
                        </div>
                        <div class="flex items-center space-x-2 text-xs text-gray-400 font-mono mt-0.5">
                            <span class="text-emerald-400">{readingTime}</span>
                            <span>·</span>
                            <span>{dateFormatted}</span>
                        </div>
                    </div>
                </div>

                {/* Top Action Icons */}
                <div class="flex items-center space-x-3 text-gray-400">
                    <button class="p-2 rounded-lg hover:bg-gray-900 hover:text-white transition-colors cursor-pointer" title="Bookmark">
                        <FiBookmark className="w-4 h-4" />
                    </button>
                    <button class="p-2 rounded-lg hover:bg-gray-900 hover:text-white transition-colors cursor-pointer" title="Share">
                        <FiShare2 className="w-4 h-4" />
                    </button>
                </div>
            </div>

            {/* Hero Image (if any) */}
            {heroImage && (
                <div class="pt-4">
                    <div class="rounded-2xl overflow-hidden border border-gray-800 bg-gray-950 shadow-2xl">
                        <img
                            src={heroImage}
                            alt={post.data.title}
                            class="w-full max-h-[460px] object-cover"
                        />
                    </div>
                </div>
            )}
        </header>

        {/* Prose Body */}
        <div class="prose prose-invert prose-emerald max-w-none pt-6 pb-16 prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white prose-p:text-gray-300 prose-p:leading-relaxed prose-p:text-base sm:prose-p:text-lg prose-a:text-emerald-400 hover:prose-a:text-emerald-300 prose-pre:border prose-pre:border-gray-800 prose-pre:bg-gray-950 prose-img:rounded-2xl prose-img:border prose-img:border-gray-800">
            <Content />
        </div>

        {/* PREVIOUS & NEXT BLOG ARROWS */}
        <div class="pt-10 pb-12 border-t border-b border-gray-800/80">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                
                {/* Previous Story */}
                {prevPost ? (
                    <a
                        href={`/blog/${prevPost.id}`}
                        class="group p-5 rounded-2xl border border-gray-800 bg-gray-900/30 hover:bg-gray-900/80 hover:border-gray-700 transition-all flex flex-col justify-between space-y-2"
                    >
                        <div class="flex items-center space-x-2 text-xs font-mono text-gray-500 group-hover:text-emerald-400 transition-colors">
                            <FiArrowLeft className="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" />
                            <span>Previous Story</span>
                        </div>
                        <h4 class="font-bold text-sm text-gray-200 group-hover:text-white transition-colors line-clamp-2 leading-snug">
                            {prevPost.data.title}
                        </h4>
                    </a>
                ) : (
                    <div class="hidden sm:block"></div>
                )}

                {/* Next Story */}
                {nextPost ? (
                    <a
                        href={`/blog/${nextPost.id}`}
                        class="group p-5 rounded-2xl border border-gray-800 bg-gray-900/30 hover:bg-gray-900/80 hover:border-gray-700 transition-all flex flex-col justify-between space-y-2 text-right sm:items-end"
                    >
                        <div class="flex items-center space-x-2 text-xs font-mono text-gray-500 group-hover:text-emerald-400 transition-colors">
                            <span>Next Story</span>
                            <FiArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                        </div>
                        <h4 class="font-bold text-sm text-gray-200 group-hover:text-white transition-colors line-clamp-2 leading-snug">
                            {nextPost.data.title}
                        </h4>
                    </a>
                ) : (
                    <div class="hidden sm:block"></div>
                )}

            </div>
        </div>

        {/* RECOMMENDATIONS (More from Lutfi Ikbal Majid) */}
        {recommendations.length > 0 && (
            <section class="pt-12 space-y-6">
                <div class="flex items-center justify-between">
                    <h3 class="text-xl font-bold text-white tracking-tight">
                        Recommended from Lutfi
                    </h3>
                    <a
                        href="/blog"
                        class="text-xs font-mono text-emerald-400 hover:text-emerald-300 flex items-center space-x-1"
                    >
                        <span>See all writings</span>
                        <FiArrowRight className="w-3 h-3" />
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    {recommendations.map((rec: any) => {
                        const recImg = getPostImage(rec);
                        const recTime = getReadingTime(rec.body || '');

                        return (
                            <a
                                href={`/blog/${rec.id}`}
                                class="group flex flex-col justify-between p-4 rounded-2xl border border-gray-800 bg-gray-900/40 hover:bg-gray-900/80 hover:border-gray-700 transition-all space-y-3"
                            >
                                {recImg && (
                                    <div class="h-32 rounded-xl overflow-hidden bg-gray-950 border border-gray-800/80">
                                        <img
                                            src={recImg}
                                            alt={rec.data.title}
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                            loading="lazy"
                                        />
                                    </div>
                                )}
                                <div class="space-y-1.5 flex-grow">
                                    <div class="text-[10px] font-mono text-emerald-400">
                                        {recTime}
                                    </div>
                                    <h4 class="font-bold text-sm text-gray-200 group-hover:text-emerald-400 transition-colors line-clamp-2 leading-snug">
                                        {rec.data.title}
                                    </h4>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </section>
        )}

    </article>
</Layout>
