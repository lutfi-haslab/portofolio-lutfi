---
import Layout from '../../layout/Layout.astro';
import { getCollection } from 'astro:content';
import { getPostImage, getReadingTime } from '../../utils/blogHelper';
import { 
    FiBookmark, 
    FiHeart, 
    FiShare2, 
    FiTrendingUp, 
    FiGithub, 
    FiTag 
} from 'react-icons/fi';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
    .filter((p) => p.id !== 'index')
    .sort((a, b) => {
        const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
        const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
        return dateB - dateA;
    });

// Featured / Staff picks for sidebar (top curated Architecture & AI stories)
const curatedPickIds = [
    'building-a-lightweight-ai-router', 
    'autonomous-multi-agent-orchestration', 
    'native-workspace-architecture-wails-vs-electron'
];
const staffPicks = sortedPosts.filter((p) => curatedPickIds.includes(p.id));
const finalStaffPicks = staffPicks.length >= 3 ? staffPicks : sortedPosts.slice(0, 3);

// Category post counts
const archPostsCount = sortedPosts.filter((p) =>
    (p.data.tags || []).some((t: string) => t.toLowerCase() === 'architecture')
).length;

const aiPostsCount = sortedPosts.filter((p) =>
    (p.data.tags || []).some((t: string) => t.toLowerCase() === 'ai')
).length;

// Collect all unique tags
const allTags = Array.from(
    new Set(
        sortedPosts.flatMap((p) => p.data.tags || ['engineering'])
    )
).slice(0, 8);
---

<Layout title="Writings — Lutfi Ikbal Majid">
    <div class="container mx-auto px-6 py-10 max-w-6xl font-sans">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            {/* LEFT MAIN STREAM (Medium Feed Style) */}
            <div class="lg:col-span-8 space-y-8">
                
                {/* Tabs bar */}
                <div class="flex items-center space-x-6 border-b border-gray-800 text-sm font-medium">
                    <button
                        data-tab="all"
                        class="category-tab pb-3 border-b-2 border-white text-white font-semibold flex items-center space-x-2 transition-all cursor-pointer"
                    >
                        <span>All Stories</span>
                        <span class="px-2 py-0.5 text-xs rounded-full bg-gray-800 text-gray-300 font-mono">
                            {sortedPosts.length}
                        </span>
                    </button>
                    <button
                        data-tab="architecture"
                        class="category-tab pb-3 border-b-2 border-transparent text-gray-400 hover:text-gray-200 transition-all flex items-center space-x-2 cursor-pointer"
                    >
                        <span>Architecture</span>
                        <span class="px-2 py-0.5 text-xs rounded-full bg-gray-800/60 text-gray-400 font-mono">
                            {archPostsCount}
                        </span>
                    </button>
                    <button
                        data-tab="ai"
                        class="category-tab pb-3 border-b-2 border-transparent text-gray-400 hover:text-gray-200 transition-all flex items-center space-x-2 cursor-pointer"
                    >
                        <span>AI</span>
                        <span class="px-2 py-0.5 text-xs rounded-full bg-gray-800/60 text-gray-400 font-mono">
                            {aiPostsCount}
                        </span>
                    </button>
                </div>

                {/* Empty State when filter matches 0 */}
                <div id="no-posts-message" class="hidden py-16 text-center text-gray-500 font-mono text-sm">
                    No stories found in this category yet.
                </div>

                {/* Posts List */}
                <div id="posts-container" class="divide-y divide-gray-800/80 space-y-8">
                    {sortedPosts.map((post) => {
                        const dateFormatted = post.data.date
                            ? new Date(post.data.date).toLocaleDateString('en-US', {
                                  month: 'short',
                                  day: 'numeric',
                                  year: 'numeric',
                              })
                            : 'Story';
                        
                        const coverImg = getPostImage(post);
                        const readingTime = getReadingTime(post.body || '');
                        const tagsLower = (post.data.tags || []).map((t: string) => t.toLowerCase());

                        return (
                            <article 
                                class="blog-article-item pt-8 first:pt-0 group"
                                data-categories={JSON.stringify(tagsLower)}
                            >
                                <a href={`/blog/${post.id}`} class="block space-y-3">
                                    
                                    {/* Author & Meta Row */}
                                    <div class="flex items-center space-x-2 text-xs font-mono text-gray-400">
                                        <img
                                            src="https://avatars.githubusercontent.com/u/108409669?v=4"
                                            alt="Lutfi"
                                            class="w-5 h-5 rounded-full object-cover"
                                        />
                                        <span class="text-gray-200 font-medium">Lutfi Ikbal Majid</span>
                                        <span class="text-gray-600">·</span>
                                        <span>{dateFormatted}</span>
                                        <span class="text-gray-600">·</span>
                                        <span class="text-emerald-400">{readingTime}</span>
                                    </div>

                                    {/* Title, Excerpt & Thumbnail */}
                                    <div class="flex items-start justify-between gap-6">
                                        <div class="space-y-2 flex-grow">
                                            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight leading-snug group-hover:text-emerald-400 transition-colors">
                                                {post.data.title}
                                            </h2>
                                            {post.data.description && (
                                                <p class="text-sm text-gray-400 line-clamp-2 leading-relaxed font-normal">
                                                    {post.data.description}
                                                </p>
                                            )}
                                        </div>

                                        {coverImg && (
                                            <div class="w-28 sm:w-40 h-20 sm:h-28 rounded-xl overflow-hidden bg-gray-900 border border-gray-800 shrink-0">
                                                <img
                                                    src={coverImg}
                                                    alt={post.data.title}
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                                    loading="lazy"
                                                />
                                            </div>
                                        )}
                                    </div>

                                    {/* Action Bar */}
                                    <div class="flex items-center justify-between pt-2 text-xs text-gray-500">
                                        <div class="flex items-center space-x-2">
                                            {post.data.tags && post.data.tags[0] && (
                                                <span class="px-2.5 py-1 rounded-full text-xs font-mono bg-gray-900 text-gray-300 border border-gray-800">
                                                    {post.data.tags[0]}
                                                </span>
                                            )}
                                            <span class="text-gray-600">·</span>
                                            <span class="text-[11px] font-mono text-gray-400">Selected story</span>
                                        </div>

                                        <div class="flex items-center space-x-4 text-gray-400">
                                            <span class="hover:text-gray-200 transition-colors">
                                                <FiBookmark className="w-4 h-4" />
                                            </span>
                                            <span class="hover:text-gray-200 transition-colors">
                                                <FiShare2 className="w-4 h-4" />
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        );
                    })}
                </div>
            </div>

            {/* RIGHT SIDEBAR (Medium Staff Picks & Recommendations) */}
            <aside class="hidden lg:block lg:col-span-4 space-y-10 pl-6 border-l border-gray-800/80">
                
                {/* Author Card */}
                <div class="p-6 rounded-2xl bg-gray-900/40 border border-gray-800 space-y-4">
                    <div class="flex items-center space-x-3">
                        <img
                            src="https://avatars.githubusercontent.com/u/108409669?v=4"
                            alt="Lutfi Ikbal Majid"
                            class="w-12 h-12 rounded-full object-cover border border-gray-700"
                        />
                        <div>
                            <h3 class="font-bold text-white text-base">Lutfi Ikbal Majid</h3>
                            <p class="text-xs text-gray-400 font-mono">Software Developer</p>
                        </div>
                    </div>
                    <p class="text-xs text-gray-300 leading-relaxed">
                        Writing about autonomous AI agents, native developer tools with Go and Wails, and modern distributed systems.
                    </p>
                    <a
                        href="https://github.com/Haslab-dev"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-gray-800 hover:bg-gray-700 text-white font-mono text-xs transition-colors w-full justify-center"
                    >
                        <FiGithub className="w-4 h-4" />
                        <span>Follow on GitHub</span>
                    </a>
                </div>

                {/* Staff Picks / Recommendations */}
                <div class="space-y-4">
                    <div class="flex items-center space-x-2 text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold">
                        <FiTrendingUp />
                        <span>Recommended Stories</span>
                    </div>

                    <div class="space-y-4">
                        {finalStaffPicks.map((pick) => (
                            <a
                                href={`/blog/${pick.id}`}
                                class="block group space-y-1"
                            >
                                <div class="text-[11px] font-mono text-gray-500">
                                    Lutfi Ikbal Majid
                                </div>
                                <h4 class="font-bold text-sm text-gray-200 group-hover:text-emerald-400 transition-colors leading-snug">
                                    {pick.data.title}
                                </h4>
                            </a>
                        ))}
                    </div>
                </div>

                {/* Recommended Topics / Tags */}
                <div class="space-y-3 pt-6 border-t border-gray-800">
                    <h4 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold">
                        Recommended Topics
                    </h4>
                    <div class="flex flex-wrap gap-2">
                        {allTags.map((tag) => (
                            <button
                                data-topic={tag}
                                class="topic-chip px-3 py-1.5 rounded-full text-xs bg-gray-900 text-gray-300 border border-gray-800 font-mono hover:border-gray-600 hover:text-white transition-colors cursor-pointer"
                            >
                                {tag}
                            </button>
                        ))}
                    </div>
                </div>

            </aside>

        </div>
    </div>

    <script is:inline>
        function initCategoryFilter() {
            const tabs = document.querySelectorAll('.category-tab');
            const articles = document.querySelectorAll('.blog-article-item');
            const emptyState = document.getElementById('no-posts-message');
            const topicChips = document.querySelectorAll('.topic-chip');

            function applyCategory(category) {
                const normalizedCat = (category || 'all').toLowerCase();
                let visibleCount = 0;

                tabs.forEach(tab => {
                    const tabCat = (tab.getAttribute('data-tab') || 'all').toLowerCase();
                    if (tabCat === normalizedCat) {
                        tab.classList.add('border-white', 'text-white', 'font-semibold');
                        tab.classList.remove('border-transparent', 'text-gray-400');
                    } else {
                        tab.classList.remove('border-white', 'text-white', 'font-semibold');
                        tab.classList.add('border-transparent', 'text-gray-400');
                    }
                });

                articles.forEach(article => {
                    const tagsRaw = article.getAttribute('data-categories') || '[]';
                    let tags = [];
                    try {
                        tags = JSON.parse(tagsRaw);
                    } catch(e) {}

                    if (normalizedCat === 'all' || tags.includes(normalizedCat)) {
                        article.style.display = 'block';
                        visibleCount++;
                    } else {
                        article.style.display = 'none';
                    }
                });

                if (emptyState) {
                    if (visibleCount === 0) {
                        emptyState.classList.remove('hidden');
                    } else {
                        emptyState.classList.add('hidden');
                    }
                }
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const cat = tab.getAttribute('data-tab') || 'all';
                    const url = new URL(window.location.href);
                    if (cat === 'all') {
                        url.searchParams.delete('category');
                    } else {
                        url.searchParams.set('category', cat);
                    }
                    window.history.replaceState({}, '', url.toString());
                    applyCategory(cat);
                });
            });

            topicChips.forEach(chip => {
                chip.addEventListener('click', () => {
                    const topic = (chip.getAttribute('data-topic') || '').toLowerCase();
                    if (topic === 'architecture' || topic === 'ai') {
                        const url = new URL(window.location.href);
                        url.searchParams.set('category', topic);
                        window.history.replaceState({}, '', url.toString());
                        applyCategory(topic);
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });
            });

            const initialCategory = new URLSearchParams(window.location.search).get('category') || 'all';
            applyCategory(initialCategory);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCategoryFilter);
        } else {
            initCategoryFilter();
        }
    </script>
</Layout>
