---
import Layout from '../../layout/Layout.astro';
import { getCollection, render } from 'astro:content';
import { FiHeart, FiMessageCircle, FiRepeat, FiShare2 } from 'react-icons/fi';

const posts = (await getCollection('social')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const rendered = await Promise.all(
    posts.map(async (post) => {
        const { Content } = await render(post);
        return { post, Content };
    })
);

const siteBase = 'https://lutfiikbalmajid.pages.dev';
const fmtDate = (d: Date) =>
    new Date(d).toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'Asia/Jakarta',
    });
---

<Layout
    title="Social — Komentar Singkat AI & Teknologi"
    description="Catatan dan komentar singkat Lutfi Ikbal Majid seputar AI, model terbaru, benchmark, dan industri teknologi. Format pendek ala X/Threads, terbit di situs sendiri: klaim dipisahkan dari bukti."
    keywords="Komentar AI Singkat, Berita AI Indonesia, GPT-6.2 Astra, Claude Mythos 5.5, Kimi K3.1 Pro, Distilasi AI, Microblog Teknologi"
>
    <div class="mx-auto w-full max-w-xl px-4 sm:px-6 font-sans">
        {/* Profile strip */}
        <header class="flex items-center gap-3 pt-6 pb-5 border-b border-gray-800">
            <div class="w-11 h-11 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-gray-950 font-bold shrink-0">L</div>
            <div class="min-w-0 leading-tight">
                <p class="font-semibold text-white text-[15px]">Lutfi Ikbal Majid</p>
                <p class="text-sm text-gray-500">@lutzfy</p>
            </div>
            <a href="https://www.threads.com/@lutzfy.21" target="_blank" rel="noopener" class="ml-auto shrink-0 text-sm font-medium text-white border border-gray-700 rounded-full px-4 py-1.5 hover:bg-gray-800 transition-colors">
                Threads
            </a>
        </header>

        {/* Timeline */}
        <div>
            {rendered.map(({ post, Content }, i) => {
                const url = `${siteBase}/social/${post.id}/`;
                const shareText = encodeURIComponent(`${post.data.title} — via @lutzfy`);
                const shareUrl = encodeURIComponent(url);
                const isLast = i === rendered.length - 1;
                return (
                    <article class="relative flex gap-3 py-5 border-b border-gray-800">
                        {/* avatar + thread line */}
                        <div class="flex flex-col items-center shrink-0">
                            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-gray-950 text-sm font-bold">L</div>
                            {!isLast && <div class="w-px flex-1 bg-gray-800 mt-2"></div>}
                        </div>

                        <div class="min-w-0 flex-1">
                            {/* header row */}
                            <div class="flex items-baseline gap-2">
                                <span class="font-semibold text-white text-[15px] whitespace-nowrap shrink-0">Lutfi Ikbal Majid</span>
                                <span class="text-sm text-gray-500 truncate min-w-0">@lutzfy · {fmtDate(post.data.date)}</span>
                                <a href={`/social/${post.id}/`} aria-label="Permalink" class="ml-auto text-gray-500 hover:text-gray-300 px-1">···</a>
                            </div>

                            {/* body: title as bold lead, then post text */}
                            <h2 class="mt-1 text-[15px] font-semibold text-white leading-snug">
                                <a href={`/social/${post.id}/`} class="hover:underline">{post.data.title}</a>
                            </h2>
                            <div class="social-body mt-1 text-[15px] leading-relaxed text-gray-200 space-y-3">
                                <Content />
                            </div>

                            {post.data.source && (
                                <p class="mt-2 text-[13px] text-gray-500">Sumber: {post.data.source}</p>
                            )}

                            {(post.data.tags || []).length > 0 && (
                                <p class="mt-2 text-[14px] text-sky-400/90">
                                    {(post.data.tags || []).map((tag: string) => (
                                        <span class="mr-2">#{tag.replace(/\s+/g, '')}</span>
                                    ))}
                                </p>
                            )}

                            {/* action bar, Threads/X style */}
                            <div class="mt-3 flex items-center gap-7 text-gray-400">
                                <button class="like-btn hover:text-rose-400 transition-colors cursor-pointer" aria-label="Suka">
                                    <FiHeart className="w-5 h-5" />
                                </button>
                                <a href={`/social/${post.id}/`} class="hover:text-sky-400 transition-colors" aria-label="Buka postingan">
                                    <FiMessageCircle className="w-5 h-5" />
                                </a>
                                <a href={`https://www.threads.net/intent/post?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" class="hover:text-emerald-400 transition-colors" aria-label="Bagikan ke Threads">
                                    <FiRepeat className="w-5 h-5" />
                                </a>
                                <button class="share-btn hover:text-sky-400 transition-colors cursor-pointer" data-url={url} data-title={post.data.title} aria-label="Bagikan">
                                    <FiShare2 className="w-5 h-5" />
                                </button>
                            </div>
                        </div>
                    </article>
                );
            })}
        </div>
    </div>

    <script>
        document.querySelectorAll('.like-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                btn.classList.toggle('text-rose-500');
            });
        });
        document.querySelectorAll('.share-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const url = btn.getAttribute('data-url') || '';
                const title = btn.getAttribute('data-title') || '';
                if (navigator.share) {
                    try { await navigator.share({ title, url }); return; } catch {}
                }
                try {
                    await navigator.clipboard.writeText(url);
                    btn.classList.add('text-emerald-400');
                    setTimeout(() => btn.classList.remove('text-emerald-400'), 1600);
                } catch {}
            });
        });
    </script>
</Layout>
