---
import Layout from '../../layout/Layout.astro';
import { getCollection, render } from 'astro:content';
import { FiShare2, FiLink2, FiTag } from 'react-icons/fi';

const posts = (await getCollection('social')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const rendered = await Promise.all(
    posts.map(async (post) => {
        const { Content } = await render(post);
        return { post, Content };
    })
);

const siteBase = 'https://lutfiikbalmajid.pages.dev';
const fmtDate = (d: Date) =>
    new Date(d).toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'Asia/Jakarta',
    });
---

<Layout
    title="Social — Komentar Singkat AI & Teknologi"
    description="Catatan dan komentar singkat Lutfi Ikbal Majid seputar AI, model terbaru, benchmark, dan industri teknologi. Format pendek ala X/Threads, terbit di situs sendiri: klaim dipisahkan dari bukti."
    keywords="Komentar AI Singkat, Berita AI Indonesia, GPT-6.2 Astra, Claude Mythos 5.5, Kimi K3.1 Pro, Distilasi AI, Microblog Teknologi"
>
    <div class="container mx-auto px-6 py-10 max-w-3xl font-sans">
        <header class="mb-8">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-gray-950 text-2xl font-bold shrink-0">L</div>
                <div>
                    <h1 class="text-2xl font-bold text-white leading-tight">Lutfi Ikbal Majid</h1>
                    <p class="text-sm text-gray-400">@lutzfy · Social</p>
                </div>
            </div>
            <p class="mt-5 text-gray-300 leading-relaxed">
                Komentar singkat soal AI dan teknologi, formatnya seperti postingan X/Threads tapi
                tinggal di rumah sendiri. Satu ide per postingan, klaim dipisahkan dari bukti.
                Setiap postingan punya tautan permanen dan tombol bagikan.
            </p>
        </header>

        <div class="space-y-5">
            {rendered.map(({ post, Content }) => {
                const url = `${siteBase}/social/${post.id}/`;
                const shareText = encodeURIComponent(post.data.title);
                const shareUrl = encodeURIComponent(url);
                return (
                    <article class="rounded-2xl border border-gray-800 bg-gray-900/60 p-5 hover:border-gray-700 transition-colors">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-gray-950 font-bold shrink-0">L</div>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-white leading-tight">Lutfi Ikbal Majid</p>
                                <p class="text-xs text-gray-500">@lutzfy · {fmtDate(post.data.date)}</p>
                            </div>
                        </div>

                        <h2 class="text-base font-semibold text-white mb-2">
                            <a href={`/social/${post.id}/`} class="hover:text-emerald-300 transition-colors">{post.data.title}</a>
                        </h2>

                        <div class="social-body text-[15px] leading-relaxed text-gray-200 space-y-3">
                            <Content />
                        </div>

                        {post.data.source && (
                            <p class="mt-3 text-xs text-gray-500">Sumber: {post.data.source}</p>
                        )}

                        {(post.data.tags || []).length > 0 && (
                            <div class="mt-3 flex flex-wrap gap-2">
                                {(post.data.tags || []).map((tag: string) => (
                                    <span class="inline-flex items-center gap-1 text-xs text-emerald-300/90 bg-emerald-400/10 border border-emerald-400/20 rounded-full px-2.5 py-0.5">
                                        <FiTag className="w-3 h-3" /> {tag}
                                    </span>
                                ))}
                            </div>
                        )}

                        <div class="mt-4 pt-3 border-t border-gray-800 flex items-center gap-4 text-sm text-gray-400">
                            <a href={`/social/${post.id}/`} class="inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors">
                                <FiLink2 className="w-4 h-4" /> Permalink
                            </a>
                            <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors">
                                <FiShare2 className="w-4 h-4" /> Bagikan ke X
                            </a>
                            <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors">
                                <FiShare2 className="w-4 h-4" /> WhatsApp
                            </a>
                            <button class="copy-link inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors cursor-pointer" data-url={url}>
                                <FiLink2 className="w-4 h-4" /> Salin tautan
                            </button>
                        </div>
                    </article>
                );
            })}
        </div>
    </div>

    <script>
        document.querySelectorAll('.copy-link').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const url = btn.getAttribute('data-url');
                try {
                    await navigator.clipboard.writeText(url || '');
                    const original = btn.innerHTML;
                    btn.innerHTML = 'Tersalin ✓';
                    setTimeout(() => (btn.innerHTML = original), 1600);
                } catch {}
            });
        });
    </script>
</Layout>
