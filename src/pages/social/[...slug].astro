---
import { getCollection, render } from 'astro:content';
import Layout from '../../layout/Layout.astro';
import { FiArrowLeft, FiShare2, FiLink2, FiTag } from 'react-icons/fi';

export async function getStaticPaths() {
    const posts = await getCollection('social');
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteBase = 'https://lutfiikbalmajid.pages.dev';
const url = `${siteBase}/social/${post.id}/`;
const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(url);
const dateFormatted = new Date(post.data.date).toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Asia/Jakarta',
});
---

<Layout
    title={post.data.title}
    description={post.data.description || post.data.title}
    keywords={(post.data.tags || []).join(', ')}
    ogType="article"
>
    <div class="container mx-auto px-6 py-10 max-w-3xl font-sans">
        <a href="/social/" class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-emerald-300 transition-colors mb-6">
            <FiArrowLeft className="w-4 h-4" /> Semua postingan Social
        </a>

        <article class="rounded-2xl border border-gray-800 bg-gray-900/60 p-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-11 h-11 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-gray-950 font-bold shrink-0">L</div>
                <div>
                    <p class="text-sm font-semibold text-white leading-tight">Lutfi Ikbal Majid</p>
                    <p class="text-xs text-gray-500">@lutzfy · {dateFormatted}</p>
                </div>
            </div>

            <h1 class="text-xl font-bold text-white mb-3">{post.data.title}</h1>

            <div class="social-body text-[15px] leading-relaxed text-gray-200 space-y-3">
                <Content />
            </div>

            {post.data.source && (
                <p class="mt-4 text-xs text-gray-500">Sumber: {post.data.source}</p>
            )}

            {(post.data.tags || []).length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                    {(post.data.tags || []).map((tag: string) => (
                        <span class="inline-flex items-center gap-1 text-xs text-emerald-300/90 bg-emerald-400/10 border border-emerald-400/20 rounded-full px-2.5 py-0.5">
                            <FiTag className="w-3 h-3" /> {tag}
                        </span>
                    ))}
                </div>
            )}

            <div class="mt-5 pt-4 border-t border-gray-800 flex items-center gap-4 text-sm text-gray-400">
                <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors">
                    <FiShare2 className="w-4 h-4" /> Bagikan ke X
                </a>
                <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors">
                    <FiShare2 className="w-4 h-4" /> WhatsApp
                </a>
                <a href={`https://www.threads.net/intent/post?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors">
                    <FiShare2 className="w-4 h-4" /> Threads
                </a>
                <button class="copy-link inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors cursor-pointer" data-url={url}>
                    <FiLink2 className="w-4 h-4" /> Salin tautan
                </button>
            </div>
        </article>
    </div>

    <script>
        document.querySelectorAll('.copy-link').forEach((btn) => {
            btn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(btn.getAttribute('data-url') || '');
                    const original = btn.innerHTML;
                    btn.innerHTML = 'Tersalin ✓';
                    setTimeout(() => (btn.innerHTML = original), 1600);
                } catch {}
            });
        });
    </script>
</Layout>
