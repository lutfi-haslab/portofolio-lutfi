---
import { getCollection, render } from 'astro:content';
import Layout from '../../layout/Layout.astro';
import { FiArrowLeft, FiGithub, FiExternalLink, FiCpu } from 'react-icons/fi';

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const siteBaseUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://lutfiikbalmajid.pages.dev';
const projectUrl = `${siteBaseUrl}/project/${project.id}`;

const projectImages: Record<string, string> = {
    kendaliai: '/images/projects/kendaliai-dashboard.png',
    forgeade: '/images/projects/forgeade.jpg',
    myairouter: '/images/projects/myairouter.jpg',
    timenotes: '/images/projects/timenotes.jpg',
};
const ogImage = projectImages[project.id] || '/images/projects/kendaliai-dashboard.png';
const fullImageUrl = `${siteBaseUrl}${ogImage}`;

const softwareSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${projectUrl}#software`,
    name: project.data.title,
    description: project.data.description,
    image: fullImageUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Cross-platform',
    author: {
        '@type': 'Person',
        name: 'Lutfi Ikbal Majid',
        url: `${siteBaseUrl}/about`,
    },
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: siteBaseUrl,
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: 'Projects',
            item: `${siteBaseUrl}/project`,
        },
        {
            '@type': 'ListItem',
            position: 3,
            name: project.data.title,
            item: projectUrl,
        },
    ],
};
---

<Layout 
    title={project.data.title} 
    description={project.data.description}
    ogImage={fullImageUrl}
    schema={[softwareSchema, breadcrumbSchema]}
>
    <article class="container mx-auto px-6 py-12 max-w-4xl">
        <a
            href="/project"
            class="inline-flex items-center space-x-2 text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors mb-8"
        >
            <FiArrowLeft />
            <span>Back to Projects</span>
        </a>

        <!-- Header -->
        <header class="space-y-4 pb-8 border-b border-gray-800">
            <div class="flex items-center space-x-2 text-xs font-mono text-emerald-400">
                <FiCpu />
                <span>SYSTEM SPECIFICATION</span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
                {project.data.title}
            </h1>

            {project.data.description && (
                <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
                    {project.data.description}
                </p>
            )}
        </header>

        <!-- Markdown Content -->
        <div class="prose prose-invert prose-emerald max-w-none pt-8 prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-400 hover:prose-a:text-emerald-300 prose-pre:border prose-pre:border-gray-800 prose-pre:bg-gray-950 prose-img:rounded-xl">
            <Content />
        </div>
    </article>
</Layout>
