---
import Layout from '../layout/Layout.astro';
import { myProjects } from '../data/my-projects';
import { getCollection } from 'astro:content';
import { 
    FiArrowRight, 
    FiExternalLink, 
    FiGithub
} from 'react-icons/fi';

// Fetch all writing articles (including technical guides)
const allWritings = await getCollection('blog');
const sortedWritings = allWritings
    .filter((b) => b.id !== 'index')
    .sort((a, b) => {
        const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
        const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
        return dateB - dateA;
    });
---

<Layout 
    title="Systems Architect & Software Developer"
    description="Interactive engineering workspace of Lutfi Ikbal Majid. Specialized in Autonomous AI Multi-Agent Systems, High-Performance Go Gateways, React Native, Wails, and Distributed Architecture."
    keywords="Lutfi Ikbal Majid, Software Engineer Indonesia, Systems Architect, AI Developer, Go Developer, React Native Engineer, Wails, Multi-Agent AI"
>
    <div class="container mx-auto px-6 py-16 max-w-5xl space-y-24 font-sans">
        
        {/* HERO SECTION */}
        <section class="space-y-6 pt-6">
            <div class="flex items-center space-x-3">
                <span class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/70 border border-emerald-800/60 text-emerald-400 font-mono text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Available for High-Impact Projects</span>
                </span>
                <span class="text-xs font-mono text-gray-500">Jakarta, Indonesia</span>
            </div>

            <div class="space-y-3">
                <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
                    Lutfi Ikbal Majid
                </h1>
                <p class="text-xl sm:text-2xl text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-400 to-blue-500 font-bold">
                    Software Developer & Systems Builder
                </p>
            </div>

            <p class="text-base sm:text-lg text-gray-300 max-w-2xl leading-relaxed">
                Engineering graduate from Telkom University. Focused on autonomous AI agent systems, native developer tools with Go and Wails, high-density web platforms, and distributed architectures.
            </p>

            <div class="flex flex-wrap items-center gap-4 pt-2">
                <a
                    href="#projects"
                    class="px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-gray-950 font-bold text-sm transition-all transform active:scale-95 shadow-lg shadow-emerald-500/20"
                >
                    View Projects
                </a>
                <a
                    href="/blog"
                    class="px-5 py-3 rounded-xl bg-gray-900 hover:bg-gray-800 border border-gray-800 text-gray-300 font-medium text-sm transition-all"
                >
                    Read Writings →
                </a>
                <a
                    href="https://github.com/Haslab-dev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-3 rounded-xl bg-gray-900 hover:bg-gray-800 border border-gray-800 text-gray-400 hover:text-white transition-colors"
                    aria-label="GitHub Profile"
                >
                    <FiGithub className="w-5 h-5" />
                </a>
            </div>
        </section>

        {/* PROJECTS SECTION */}
        <section id="projects" class="space-y-8 scroll-mt-20">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-gray-800 pb-4 gap-4">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                        Projects
                    </h2>
                    <p class="text-sm text-gray-400 mt-1">
                        Production platforms, autonomous agent systems, and native developer environments.
                    </p>
                </div>
                <a
                    href="/project"
                    class="text-xs font-mono text-emerald-400 hover:text-emerald-300 flex items-center space-x-1 font-semibold"
                >
                    <span>View all {myProjects.length} projects</span>
                    <FiArrowRight />
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {myProjects.slice(0, 4).map((project) => (
                    <div class="group rounded-2xl border border-gray-800 bg-gray-900/40 hover:bg-gray-900/80 hover:border-gray-700 overflow-hidden flex flex-col transition-all hover:shadow-xl hover:shadow-emerald-950/20">
                        <div class="relative h-56 overflow-hidden bg-gray-950 border-b border-gray-800">
                            <img
                                src={project.img_url}
                                alt={project.work_title}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                            />
                            <div class="absolute top-3 right-3">
                                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase tracking-wider bg-gray-950/90 text-emerald-400 border border-emerald-900/60 backdrop-blur-md">
                                    {project.type}
                                </span>
                            </div>
                        </div>

                        <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
                            <div>
                                <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">
                                    {project.work_title}
                                </h3>
                                <p class="text-xs text-gray-400 mt-2 line-clamp-3 leading-relaxed">
                                    {project.detail}
                                </p>
                            </div>

                            <div>
                                <div class="flex flex-wrap gap-1.5 mb-4">
                                    {project.tags.map((tag) => (
                                        <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-gray-950 text-gray-300 border border-gray-800">
                                            {tag}
                                        </span>
                                    ))}
                                </div>

                                <div class="flex items-center justify-between pt-3 border-t border-gray-800/80 text-xs font-mono">
                                    {project.url && (
                                        <a
                                            href={project.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center space-x-1.5 text-gray-400 hover:text-white transition-colors"
                                        >
                                            <span>GitHub</span>
                                            <FiExternalLink className="w-3.5 h-3.5" />
                                        </a>
                                    )}
                                    <a
                                        href="/project"
                                        class="inline-flex items-center space-x-1 text-emerald-400 hover:text-emerald-300 transition-colors ml-auto font-semibold"
                                    >
                                        <span>Details</span>
                                        <FiArrowRight className="w-3.5 h-3.5" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {/* WRITINGS SECTION */}
        <section id="writings" class="space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-gray-800 pb-4 gap-4">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                        Writings
                    </h2>
                    <p class="text-sm text-gray-400 mt-1">
                        Technical articles, architecture notes, and engineering guides.
                    </p>
                </div>
                <a
                    href="/blog"
                    class="text-xs font-mono text-purple-400 hover:text-purple-300 flex items-center space-x-1 font-semibold"
                >
                    <span>View all writings ({sortedWritings.length})</span>
                    <FiArrowRight />
                </a>
            </div>

            <div class="space-y-3">
                {sortedWritings.slice(0, 6).map((writing) => {
                    const dateFormatted = writing.data.date
                        ? new Date(writing.data.date).toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                          })
                        : 'Article';

                    return (
                        <a
                            href={`/blog/${writing.id}`}
                            class="group block p-5 rounded-2xl border border-gray-800/80 bg-gray-900/30 hover:bg-gray-900/80 hover:border-purple-500/40 transition-all"
                        >
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <div class="space-y-1">
                                    <h3 class="font-bold text-gray-200 group-hover:text-purple-400 transition-colors text-base">
                                        {writing.data.title}
                                    </h3>
                                    {writing.data.description && (
                                        <p class="text-xs text-gray-400 line-clamp-1 max-w-2xl leading-relaxed">
                                            {writing.data.description}
                                        </p>
                                    )}
                                </div>
                                <div class="flex items-center space-x-3 shrink-0 text-xs font-mono text-gray-500">
                                    <span>{dateFormatted}</span>
                                    <FiArrowRight className="w-3.5 h-3.5 text-gray-600 group-hover:text-purple-400 transition-colors" />
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>

    </div>
</Layout>
