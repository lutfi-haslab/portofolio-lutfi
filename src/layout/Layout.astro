---
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { CommandPalette } from '../components/CommandPalette';

interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    ogImage?: string;
    ogType?: 'website' | 'article' | 'profile';
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
    schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
    title,
    description,
    keywords,
    ogImage,
    ogType = 'website',
    publishedTime,
    modifiedTime,
    tags = [],
    schema,
} = Astro.props;

const siteName = "Lutfi Ikbal Majid — Engineering Workspace";
const siteBaseUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://lutfiikbalmajid.pages.dev';

const fullTitle = title
    ? `${title} | Lutfi Ikbal Majid`
    : "Lutfi Ikbal Majid — Systems Architect & Software Engineer";

const defaultDescription =
    'Interactive engineering workspace of Lutfi Ikbal Majid. Specialized in Autonomous AI Multi-Agent Systems, High-Performance Go Proxies, React Native, Wails, and Modern Software Architecture.';

const metaDescription = description || defaultDescription;

const defaultKeywords =
    'Lutfi Ikbal Majid, Software Engineer, Systems Architect, Autonomous AI Agents, Multi-Agent Systems, Golang, Wails, React, TypeScript, Astro, Next.js, KendaliAI, ForgeADE, MyAiRouter, Timenotes, Indonesia Software Engineer';

const metaKeywords = keywords ? `${keywords}, ${defaultKeywords}` : defaultKeywords;

const canonicalURL = new URL(Astro.url.pathname, siteBaseUrl).toString();

// Resolve OG image to absolute URL
let absoluteOgImage: string;
if (ogImage) {
    if (ogImage.startsWith('http://') || ogImage.startsWith('https://')) {
        absoluteOgImage = ogImage;
    } else {
        const cleanPath = ogImage.startsWith('/') ? ogImage : `/${ogImage}`;
        absoluteOgImage = `${siteBaseUrl}${cleanPath}`;
    }
} else {
    absoluteOgImage = `${siteBaseUrl}/images/projects/kendaliai-dashboard.png`;
}

// Base structured data: Person & WebSite
const baseWebsiteSchema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteBaseUrl}/#website`,
    url: siteBaseUrl,
    name: 'Lutfi Ikbal Majid — Engineering Workspace',
    description: defaultDescription,
    publisher: {
        '@id': `${siteBaseUrl}/#person`,
    },
    inLanguage: 'en-US',
};

const basePersonSchema = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteBaseUrl}/#person`,
    name: 'Lutfi Ikbal Majid',
    url: siteBaseUrl,
    image: 'https://avatars.githubusercontent.com/u/108409669?v=4',
    jobTitle: 'Senior Software Engineer & Systems Architect',
    worksFor: {
        '@type': 'Organization',
        name: 'Independent Engineering',
    },
    sameAs: [
        'https://github.com/Haslab-dev',
        'https://github.com/lutfi-haslab',
        'https://linkedin.com/in/lutfiikbalmajid',
        'https://twitter.com/haslab_dev',
    ],
    knowsAbout: [
        'Software Architecture',
        'Autonomous Multi-Agent AI Systems',
        'Golang High Performance Systems',
        'Low-Latency AI Routing',
        'React & React Native',
        'Wails Desktop Engineering',
        'Distributed Systems',
    ],
};

const combinedSchema = schema
    ? Array.isArray(schema)
        ? [baseWebsiteSchema, basePersonSchema, ...schema]
        : [baseWebsiteSchema, basePersonSchema, schema]
    : [baseWebsiteSchema, basePersonSchema];
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />

        <!-- Primary Meta Tags -->
        <title>{fullTitle}</title>
        <meta name="title" content={fullTitle} />
        <meta name="description" content={metaDescription} />
        <meta name="keywords" content={metaKeywords} />
        <meta name="author" content="Lutfi Ikbal Majid" />
        <meta name="creator" content="Lutfi Ikbal Majid" />
        <meta name="publisher" content="Lutfi Ikbal Majid" />

        <!-- Search Engine Directives (Google, Yahoo, Bing, DuckDuckGo) -->
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta
            name="googlebot"
            content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
        <meta
            name="bingbot"
            content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />

        <!-- Application & Theme Directives -->
        <meta name="application-name" content="Lutfi Majid" />
        <meta name="apple-mobile-web-app-title" content="Lutfi Majid" />
        <meta name="theme-color" content="#030712" />
        <meta name="color-scheme" content="dark" />

        <!-- Open Graph / Facebook -->
        <meta property="og:site_name" content={siteName} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image" content={absoluteOgImage} />
        <meta property="og:image:secure_url" content={absoluteOgImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={fullTitle} />

        {/* Article Open Graph Specifics */}
        {ogType === 'article' && publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
        )}
        {ogType === 'article' && (modifiedTime || publishedTime) && (
            <meta property="article:modified_time" content={modifiedTime || publishedTime} />
        )}
        {ogType === 'article' && (
            <meta property="article:author" content="https://lutfiikbalmajid.pages.dev/about" />
            <meta property="article:section" content="Engineering & Technology" />
        )}
        {ogType === 'article' &&
            tags.map((tag) => <meta property="article:tag" content={tag} />)}

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@haslab_dev" />
        <meta name="twitter:creator" content="@haslab_dev" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={absoluteOgImage} />
        <meta name="twitter:image:alt" content={fullTitle} />

        <!-- Canonical & Feeds -->
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" type="application/rss+xml" title="Lutfi Ikbal Majid — RSS Feed" href={`${siteBaseUrl}/rss.xml`} />
        <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteBaseUrl}/sitemap-index.xml`} />

        <!-- Icons & Manifest -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" sizes="180x180" href="/assets-img/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- JSON-LD Structured Data Schema -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify(combinedSchema)} />
    </head>

    <body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col font-sans selection:bg-emerald-500/30 selection:text-emerald-300">
        <!-- Subtle Grid & Radial Background -->
        <div class="fixed inset-0 pointer-events-none -z-10">
            <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[450px] bg-gradient-to-b from-emerald-500/10 via-cyan-500/5 to-transparent blur-3xl opacity-60"></div>
        </div>

        <Header client:load />
        <CommandPalette client:load />

        <main class="flex-grow">
            <slot />
        </main>

        <Footer client:visible />
    </body>
</html>
